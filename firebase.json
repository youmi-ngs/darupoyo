{
  "hosting": {
    "site": "darupoyo",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [{"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]}]
  },
  "firestore": {"rules": "backend/firestore.rules", "indexes": "backend/firestore.indexes.json"},
  "storage": {"rules": "backend/storage.rules"},
  "emulators": {
    "auth": {"host": "127.0.0.1", "port": 9099},
    "firestore": {"host": "127.0.0.1", "port": 8085},
    "storage": {"host": "127.0.0.1", "port": 9199},
    "ui": {"enabled": true, "host": "127.0.0.1", "port": 4000},
    "singleProjectMode": true
  }
}

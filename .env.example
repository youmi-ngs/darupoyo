# Development: Vite proxies /api to this Backend. No secret values here.
BACKEND_ORIGIN=http://127.0.0.1:8080
# For Firebase Hosting builds use /api (same-origin Cloud Run rewrite).
# Use a full URL only when intentionally connecting to a separate API host.
VITE_API_BASE_URL=http://127.0.0.1:8080/api
# VITE_* values are public browser code. NEVER put credentials in them.
# Development only: answer API calls with the in-browser mock (src/mock.js).
# VITE_API_MOCK=1

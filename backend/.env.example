# Local sandbox only. Data disappears on restart; never deploy these modes.
APP_ENV=local
DATA_BACKEND=memory
AUTH_MODE=dev
PRAISE_BACKEND=fallback
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DAY_TIMEZONE=Asia/Tokyo
SYNC_WINDOW_SECONDS=300
# Cloud: APP_ENV=production DATA_BACKEND=firestore AUTH_MODE=firebase
# PRAISE_BACKEND=vertex and fill these non-secret identifiers.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
STORAGE_BUCKET=
GEMINI_MODEL=
# Public Firebase Web app configuration; never put Admin credentials here.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

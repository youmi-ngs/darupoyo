{
  "name": "darupoyo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:backend": "bash backend/scripts/dev.sh",
    "dev:all": "node scripts/dev-all.mjs",
    "setup:backend": "uv venv --python 3.12 backend/.venv && uv pip sync --python backend/.venv/bin/python backend/requirements-dev.lock",
    "test:backend": "cd backend && uv run --python .venv/bin/python --no-project python -m pytest -q",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:team": "node scripts/dev-team.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@mediapipe/tasks-audio": "0.10.32",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
